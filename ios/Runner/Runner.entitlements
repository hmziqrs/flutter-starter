<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- push-notifications (Wave-5b): APNs entitlement. The development value
	     is used for the dev sandbox; the release build uses
	     Release.entitlements with `production`. The real Firebase adapter is
	     only constructed when a consumer wires GoogleService-Info.plist;
	     without it, NoopNotificationsRepository surfaces denied honestly. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- deep-linking (Wave-5b): associated domains for Universal Links.
	     Empty by default; a consumer replaces this with the real
	     `applinks:<host>` entry once the apple-app-site-association file is
	     hosted. The compile-time ALLOWED_DEEP_LINK_HOSTS define mirrors this
	     list at the Dart layer (AppConfig.allowedDeepLinkHosts). -->
	<key>com.apple.developer.associated-domains</key>
	<array/>
</dict>
</plist>
