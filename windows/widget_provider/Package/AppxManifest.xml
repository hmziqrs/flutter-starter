<?xml version="1.0" encoding="utf-8"?>
<!-- __RUNTIME_*__ and __PUBLISHER__ are filled in by build.ps1. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap uap3 com rescap desktop6">

  <Identity
    Name="com.example.starter.widgets"
    Publisher="__PUBLISHER__"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Starter widgets</DisplayName>
    <PublisherDisplayName>Starter</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- The provider reads the real native_surfaces.json the app writes, and watches
         it for changes, so its view of AppData must not be a private copy. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency
      Name="__RUNTIME_NAME__"
      MinVersion="__RUNTIME_VERSION__"
      Publisher="__RUNTIME_PUBLISHER__" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="Provider" Executable="StarterWidgetProvider.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Starter widgets"
        Description="Widgets for Starter"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="StarterWidgetProvider.exe" DisplayName="Starter widgets">
              <com:Class Id="F55748D8-A04C-4675-BB30-3C8128234385" DisplayName="Starter widgets" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="com.microsoft.windows.widgets"
            DisplayName="Starter"
            Id="StarterWidgets"
            PublicFolder="Public">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\Square44x44Logo.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="F55748D8-A04C-4675-BB30-3C8128234385" />
                </Activation>
                <Definitions>
                  <Definition
                    Id="Surface"
                    DisplayName="Starter"
                    Description="What the app is doing right now"
                    AllowMultiple="false">
                    <Capabilities>
                      <Capability><Size Name="small" /></Capability>
                      <Capability><Size Name="medium" /></Capability>
                      <Capability><Size Name="large" /></Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Square44x44Logo.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\ScreenshotDark.png" DisplayAltText="The Starter widget" />
                      </Screenshots>
                      <DarkMode>
                        <Screenshots>
                          <Screenshot Path="Assets\ScreenshotDark.png" DisplayAltText="The Starter widget" />
                        </Screenshots>
                      </DarkMode>
                      <LightMode>
                        <Screenshots>
                          <Screenshot Path="Assets\ScreenshotLight.png" DisplayAltText="The Starter widget" />
                        </Screenshots>
                      </LightMode>
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
