<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The HTTP client needs this in release builds too. Declared here rather
         than left to whichever plugin happens to add it. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Biometric unlock (local_auth): BiometricPrompt requires USE_BIOMETRIC. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Camera capture for the profile photo; the rationale sheet shows first.
         Choosing a photo uses the system picker, which needs no permission, so
         READ_MEDIA_IMAGES is deliberately absent: it never applied below API 33,
         and Google Play restricts it to apps whose core purpose needs it. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- push-notifications (Wave-5b): runtime notification permission on
         API 33+. The Noop default never requests it; the optional real
         Firebase adapter requests it via NotificationsRepository. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Android 16 Live Updates: lets SurfaceLive ask for its ongoing notification
         to be promoted to the status bar chip and the top of the lock screen. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <!-- This starter shows no ads, so drop the advertising IDs Firebase Analytics
         merges in. Remove these lines if your app starts using them. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove"/>
    <!-- Keep television hardware optional so the same artifact remains installable
         on phones, tablets, Android TV, and Google TV. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- No auto backup: secure storage keys live in the device Keystore, so a
         restored copy of its data cannot be decrypted on the new device. -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TvActivity"
            android:banner="@drawable/tv_banner"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:icon="@mipmap/ic_launcher_tv"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:taskAffinity=""
            android:theme="@style/TvLaunchTheme"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/TvNormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- deep-linking (Wave-5b): Android App Links autoVerify
                 intent-filter. Empty scheme/host placeholders; a consumer
                 replaces them with the real associated host once the
                 assetlinks.json file is hosted at
                 https://<host>/.well-known/assetlinks.json. The compile-time
                 ALLOWED_DEEP_LINK_HOSTS define mirrors this list at the Dart
                 layer (AppConfig.allowedDeepLinkHosts). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <!-- <data android:host="example.com"/> -->
            </intent-filter>
        </activity>
        <!-- Native surfaces, see docs/native_surfaces.md. -->
        <receiver
            android:name=".SurfaceSmallWidgetProvider"
            android:exported="false"
            android:label="@string/surface_widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/surface_widget_small_info" />
        </receiver>
        <receiver
            android:name=".SurfaceMediumWidgetProvider"
            android:exported="true"
            android:label="@string/surface_widget_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/surface_widget_medium_info" />
        </receiver>
        <receiver
            android:name=".SurfaceLiveDismissedReceiver"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
