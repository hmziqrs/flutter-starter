<?xml version="1.0" encoding="utf-8"?>
<!-- Doubles as the widget picker's preview, so its defaults are the sample state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/surface_widget_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/surface_title"
            style="@style/SurfaceText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name" />

        <ImageView
            android:id="@+id/surface_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/surface_dot"
            android:tint="@color/surface_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/surface_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/surface_gauge"
            android:layout_width="108dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/surface_gauge_track" />

            <ImageView
                android:id="@+id/surface_gauge_arc"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/surface_gauge_sample"
                android:tint="@color/surface_accent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/surface_gauge_value"
                    style="@style/SurfaceText.Figure"
                    android:layout_width="56dp"
                    android:layout_height="24dp"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="12sp"
                    android:gravity="center"
                    android:text="@string/surface_preview_value" />

                <TextView
                    android:id="@+id/surface_gauge_label"
                    style="@style/SurfaceText"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/surface_preview_label"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/surface_stat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/surface_stat_value"
                    style="@style/SurfaceText.Figure"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:autoSizeMaxTextSize="44sp"
                    android:autoSizeMinTextSize="18sp"
                    android:gravity="center_vertical|start" />

                <TextView
                    android:id="@+id/surface_stat_label"
                    style="@style/SurfaceText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/surface_subtitle_strong"
                style="@style/SurfaceText.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="@string/surface_preview_subtitle" />

            <TextView
                android:id="@+id/surface_subtitle_lead"
                style="@style/SurfaceText.Lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/surface_subtitle_muted"
                style="@style/SurfaceText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/surface_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@color/surface_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/surface_action_1"
                style="@style/SurfaceText.Action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="@string/surface_preview_action_1" />

            <TextView
                android:id="@+id/surface_action_2"
                style="@style/SurfaceText.Action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="@string/surface_preview_action_2" />

            <TextView
                android:id="@+id/surface_action_3"
                style="@style/SurfaceText.Action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="@string/surface_preview_action_3" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
