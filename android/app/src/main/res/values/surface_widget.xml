<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="surface_widget_radius">20dp</dimen>

    <style name="SurfaceText">
        <item name="android:fontFamily">@font/onest_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/surface_muted</item>
    </style>
    <style name="SurfaceText.Title">
        <item name="android:fontFamily">@font/onest_medium</item>
        <item name="android:textColor">@color/surface_text</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="SurfaceText.Figure">
        <item name="android:fontFamily">@font/onest_medium</item>
        <item name="android:textColor">@color/surface_text</item>
        <item name="android:letterSpacing">-0.05</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>
    <style name="SurfaceText.Headline">
        <item name="android:fontFamily">@font/onest_medium</item>
        <item name="android:textColor">@color/surface_text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="SurfaceText.Caption">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="SurfaceText.Action">
        <item name="android:fontFamily">@font/onest_medium</item>
        <item name="android:textColor">@color/surface_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
