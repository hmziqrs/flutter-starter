<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="surface_widget_radius">20dp</dimen>

    <!-- The system font, not Onest: launchers inflate RemoteViews in a restricted
         context, where TextView refuses to load an app's font resources. -->
    <style name="SurfaceText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/surface_muted</item>
    </style>
    <style name="SurfaceText.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/surface_text</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="SurfaceText.Figure">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/surface_text</item>
        <item name="android:letterSpacing">-0.05</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>
    <style name="SurfaceText.Headline">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/surface_text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="SurfaceText.Lead">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/surface_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:maxLines">4</item>
    </style>
    <style name="SurfaceText.Caption">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="SurfaceText.Action">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/surface_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
