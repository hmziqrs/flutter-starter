# Copy to android/key.properties, which git ignores, and fill it in. Release
# builds then sign with this key instead of the debug key.
#
# Create a key with:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias upload
storeFile=../upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
